# ── semantic-knx-gateway (KNX IoT 3rd Party API) ─────────────────────────────
# Host root ONLY, WITHOUT the /api/vX path — the API base path is a code
# constant (KNX_API_PATH in src/config.js), not a deployment parameter.
# /oauth/access is called directly against this host root (no prefix); all
# other endpoints (/datapoints, /subscriptions, ...) use
# {KNX_API_BASE_URL}{KNX_API_PATH}.
KNX_API_BASE_URL=https://eibesthal.local:3000
KNX_OAUTH_CLIENT_ID=knx-mqtt-forwarder
KNX_OAUTH_CLIENT_SECRET=change-me

# How to address the datapoint subscription (subscriptionDatapoints):
# - "all" (default): address each datapoint in the local cache individually,
#   covering the whole installation. (Location-based cascading with
#   expand=true is allowed by the spec but is confirmed unsupported by the
#   gateway: "Invalid relationship type 'location'.")
# - "datapoint": a single datapoint (KNX_SUBSCRIPTION_TARGET_ID)
KNX_SUBSCRIPTION_MODE=all
# Required only when MODE=datapoint.
KNX_SUBSCRIPTION_TARGET_ID=
# Subscription lifetime in seconds; renewal occurs at half the lifetime.
KNX_SUBSCRIPTION_LIFETIME_S=3600

# ── HTTP callback (must be reachable from the gateway) ──────────────────────
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=8070
CALLBACK_PATH=
# Public URL provided to the gateway when creating the subscription.
# CALLBACK_PATH is derived from this URL by default (normal case); set it
# explicitly only if a reverse proxy rewrites the path (public path != internal
# path; see README).
CALLBACK_PUBLIC_URL=http://knx-mqtt-forwarder.local:8070/callback
# Shared secret for HMAC-SHA256 signature validation (X-Callback-Signature)
CALLBACK_SECRET=change-me-too

# ── MQTT / EMQX ──────────────────────────────────────────────────────────────
MQTT_URL=mqtt://emqx.local:1883
MQTT_USERNAME=knx-mqtt-forwarder
MQTT_PASSWORD=change-me-as-well
MQTT_CLIENT_ID=knx-mqtt-forwarder
MQTT_STATE_TOPIC_PREFIX=knx/state
MQTT_BUS_TOPIC_PREFIX=knx/bus
MQTT_STATUS_TOPIC=knx/bridge/status

# ── Other settings ───────────────────────────────────────────────────────────
# Set to debug to log each datapoint's resource ID, callback ID, GA, title, and DPT.
LOG_LEVEL=info
# Time zone for log timestamps (IANA time zone name)
TZ=Europe/Vienna
