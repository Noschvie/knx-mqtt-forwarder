# ── semantic-knx-gateway (KNX IoT 3rd Party API) ────────────────────────────
# NUR die Host-Root, OHNE /api/vX-Pfad — der API-Basispfad ist eine
# Code-Konstante (KNX_API_PATH in src/config.js), kein Deployment-Parameter.
# /oauth/access wird direkt gegen diese Host-Root aufgerufen (kein Präfix),
# alle übrigen Endpoints (/datapoints, /subscriptions, ...) gegen
# {KNX_API_BASE_URL}{KNX_API_PATH}.
KNX_API_BASE_URL=https://eibesthal.local:3000
KNX_OAUTH_CLIENT_ID=knx-mqtt-forwarder
KNX_OAUTH_CLIENT_SECRET=change-me

# Wie die Datapoint-Subscription adressiert wird (subscriptionDatapoints):
# - "all" (Default): jeden im lokalen Cache bekannten Datapoint einzeln
#   adressieren -> deckt die komplette Installation ab. (Ein location-basiertes
#   Cascading mit expand=true wäre laut Spec vorgesehen, wird vom Gateway aber
#   nachweislich nicht unterstützt — "Invalid relationship type 'location'".)
# - "datapoint": ein einzelner Datapoint (KNX_SUBSCRIPTION_TARGET_ID)
KNX_SUBSCRIPTION_MODE=all
# Nur bei MODE=datapoint erforderlich.
KNX_SUBSCRIPTION_TARGET_ID=
# Lifetime der Subscription in Sekunden; Renewal erfolgt bei halber Lifetime.
KNX_SUBSCRIPTION_LIFETIME_S=3600

# ── HTTP-Callback (muss vom Gateway aus erreichbar sein) ────────────────────
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=8070
CALLBACK_PATH=
# Öffentlich erreichbare URL, die dem Gateway bei der Subscription mitgeteilt wird.
# CALLBACK_PATH wird per Default aus dieser URL abgeleitet (Normalfall) — nur
# explizit setzen, wenn ein vorgeschalteter Reverse Proxy den Pfad umschreibt
# (öffentlicher Pfad != interner Pfad, siehe README).
CALLBACK_PUBLIC_URL=http://knx-mqtt-forwarder.local:8070/callback
# Shared Secret für die HMAC-SHA256-Signaturprüfung (X-Callback-Signature)
CALLBACK_SECRET=change-me-too

# ── MQTT / EMQX ──────────────────────────────────────────────────────────────
MQTT_URL=mqtt://emqx.local:1883
MQTT_USERNAME=knx-mqtt-forwarder
MQTT_PASSWORD=change-me-as-well
MQTT_CLIENT_ID=knx-mqtt-forwarder
MQTT_STATE_TOPIC_PREFIX=knx/state
MQTT_BUS_TOPIC_PREFIX=knx/bus
MQTT_STATUS_TOPIC=knx/bridge/status

# ── Sonstiges ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Zeitzone für Log-Zeitstempel (IANA-Zeitzonenname)
TZ=Europe/Vienna
